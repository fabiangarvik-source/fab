{
  "crons": [
    {
      "path": "/api/cron?kind=open",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron?kind=open",
      "schedule": "0 22 * * *"
    },
    {
      "path": "/api/cron?kind=close",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron?kind=results",
      "schedule": "10 5 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/app.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
